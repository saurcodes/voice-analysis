# Keycloak OIDC (wired in Plan 5 Task 2); the public client is "vocal-coach-web".
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/vocal-coach
VITE_KEYCLOAK_CLIENT_ID=vocal-coach-web

# Base URL for API calls; empty uses the dev server proxy (see vite.config.ts) or nginx in prod.
VITE_API_BASE_URL=
