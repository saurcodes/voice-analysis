# Postgres (compose)
POSTGRES_USER=vocal
POSTGRES_PASSWORD=vocal
# Keycloak (compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/vocal-coach
KEYCLOAK_AUDIENCE=vocal-coach-web
# Realm imported on first start. The dev file has a demo/demo user and the password grant (smoke script);
# keycloak/realm-export.json is production-shaped (no users, no password grant, no self-registration).
KEYCLOAK_REALM_FILE=./keycloak/realm-export.dev.json
# Backend
DATABASE_URL=postgresql+psycopg://vocal:vocal@localhost:5432/vocal_coach
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=data
JOB_WORKERS=1
MAX_UPLOAD_MB=500
# Frontend (build-time only: Vite inlines these into the static bundle, so changing them
# after the frontend image is built needs `docker compose up -d --build frontend` again)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vocal-coach
VITE_KEYCLOAK_CLIENT_ID=vocal-coach-web
# Google Drive (Plan 7); see backend/README.md's "Google Drive" section for the full setup.
# Signs and verifies the OAuth state parameter. Leave it commented out while Drive is not configured
# (the dev default is fine then); once GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and DRIVE_TOKEN_KEY are
# set, the backend refuses to start unless this is a random value of at least 32 characters.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# Fernet key that encrypts stored Drive refresh tokens (startup refuses a malformed one); generate with:
#   backend/.venv/bin/python -c "from vocal_coach.drive.crypto import generate_key; print(generate_key())"
DRIVE_TOKEN_KEY=
# From a Google Cloud Console OAuth 2.0 Web application client (APIs and Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorised redirect URI in the Google Cloud Console entry exactly. Leave this
# commented out to keep each mode's own default: http://localhost:3000/api/drive/callback under
# `docker compose` (the nginx /api proxy keeps the browser round trip on the frontend origin), or
# http://localhost:8000/api/drive/callback for a bare `uvicorn --reload` dev loop against the
# backend directly. Uncomment and set it only when your Google Cloud redirect URI differs.
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
# Overrides llm.base_url for the backend container only (e.g. to reach a host-run Ollama at
# http://host.docker.internal:11434/v1); leave unset to use config.yaml's base_url as-is.
LLM_BASE_URL_OVERRIDE=
