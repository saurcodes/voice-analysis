# Postgres (compose)
POSTGRES_USER=vocal
POSTGRES_PASSWORD=vocal
# Keycloak (compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/vocal-coach
KEYCLOAK_AUDIENCE=vocal-coach-web
# Realm imported on first start. The dev file has a demo/demo user and the password grant (smoke script);
# keycloak/realm-export.json is production-shaped (no users, no password grant, no self-registration).
KEYCLOAK_REALM_FILE=./keycloak/realm-export.dev.json
# Backend
DATABASE_URL=postgresql+psycopg://vocal:vocal@localhost:5432/vocal_coach
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=data
JOB_WORKERS=1
MAX_UPLOAD_MB=500
# Frontend (build-time only: Vite inlines these into the static bundle, so changing them
# after the frontend image is built needs `docker compose up -d --build frontend` again)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vocal-coach
VITE_KEYCLOAK_CLIENT_ID=vocal-coach-web
# Later plans
SECRET_KEY=
DRIVE_TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
