# Copy to .env and edit: cp .env.example .env
# docker compose reads this file for variable substitution; the backend also reads it (from its
# working directory) when run with uvicorn outside Docker. See the root README's configuration
# reference for every key, its default and which service uses it.

# --- Postgres -------------------------------------------------------------------------------
# Database user; compose uses it for Postgres itself, for Keycloak and for the backend.
POSTGRES_USER=vocal
# Database password for POSTGRES_USER.
POSTGRES_PASSWORD=vocal

# --- Keycloak -------------------------------------------------------------------------------
# Admin console login at http://localhost:8080/admin (bootstrap admin, created on first start).
KEYCLOAK_ADMIN=admin
# Password for KEYCLOAK_ADMIN; change it for anything but a local machine.
KEYCLOAK_ADMIN_PASSWORD=admin
# Realm imported on first start only. The dev file has a demo/demo user and the password grant
# (scripts/smoke.sh needs it); keycloak/realm-export.json is production-shaped (no users, no
# password grant, no self-registration).
KEYCLOAK_REALM_FILE=./keycloak/realm-export.dev.json

# --- Backend --------------------------------------------------------------------------------
# Token issuer the backend accepts; must be the URL the browser uses to reach the realm.
KEYCLOAK_ISSUER=http://localhost:8080/realms/vocal-coach
# Audience the access token must carry (the realm's audience mapper adds it).
KEYCLOAK_AUDIENCE=vocal-coach-web
# Local dev only: where the backend fetches Keycloak's signing keys. Unset derives it from
# KEYCLOAK_ISSUER; compose pins it to http://keycloak:8080/... on the compose network.
# KEYCLOAK_JWKS_URL_OVERRIDE=
# Local dev only (uvicorn outside Docker); compose builds its own URL from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://vocal:vocal@localhost:5432/vocal_coach
# Browser origin of the frontend (Drive callback redirects, cookie Secure flag); use
# http://localhost:5173 when running the Vite dev server against a local uvicorn.
FRONTEND_ORIGIN=http://localhost:3000
# Local dev only: uploads and Drive cache directory; compose pins it to /data in a volume.
DATA_DIR=data
# Number of job worker processes (each loads its own whisper model).
JOB_WORKERS=1
# Upload size cap in MB (413 above it).
MAX_UPLOAD_MB=500
# Total Drive cache size cap in MB per server; least recently used files are evicted first.
# Not forwarded by docker-compose.yml: takes effect for a local uvicorn, or add it to the
# backend service's environment in docker-compose.yml.
# CACHE_MAX_MB=2048
# Drive download cap in MB; defaults to MAX_UPLOAD_MB. Same compose caveat as CACHE_MAX_MB.
# DRIVE_MAX_MB=500
# Local dev only: false skips the ffmpeg startup check (API work on a host without ffmpeg).
# REQUIRE_FFMPEG=true

# --- Frontend container ---------------------------------------------------------------------
# Read at container start and written into the runtime /config.json; no rebuild needed to change.
# Keycloak base URL as the browser sees it.
KEYCLOAK_URL=http://localhost:8080
# Realm name.
KEYCLOAK_REALM=vocal-coach
# Public OIDC client id.
KEYCLOAK_CLIENT_ID=vocal-coach-web

# --- LLM coaching ---------------------------------------------------------------------------
# Optional bearer token for the openai_compatible provider (leave empty for a local Ollama).
OPENAI_COMPAT_API_KEY=
# Required only when config.yaml sets llm.provider: anthropic.
ANTHROPIC_API_KEY=
# Replaces config.yaml's llm.base_url in the backend. Compose defaults it to
# http://host.docker.internal:11434/v1 (a host-run Ollama) while this line stays commented out;
# setting it to an empty value disables the override. Under Rancher Desktop use
# http://host.rancher-desktop.internal:11434/v1.
# LLM_BASE_URL_OVERRIDE=http://host.docker.internal:11434/v1

# --- Google Drive ---------------------------------------------------------------------------
# See backend/README.md's "Google Drive" section for the Google Cloud Console setup.
# Signs and verifies the OAuth state parameter. Leave it commented out while Drive is not
# configured (the dev default is fine then); once GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and
# DRIVE_TOKEN_KEY are set, the backend refuses to start unless this is a random value of at
# least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# Fernet key that encrypts stored Drive refresh tokens (startup refuses a malformed one).
# Generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DRIVE_TOKEN_KEY=
# OAuth 2.0 Web application client id from the Google Cloud Console.
GOOGLE_CLIENT_ID=
# Secret for GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=
# Must match the authorised redirect URI in the Google Cloud Console entry exactly. Leave this
# commented out to keep each mode's own default: http://localhost:3000/api/drive/callback under
# docker compose (the nginx /api proxy keeps the browser round trip on the frontend origin), or
# http://localhost:8000/api/drive/callback for a bare uvicorn dev loop against the backend.
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
